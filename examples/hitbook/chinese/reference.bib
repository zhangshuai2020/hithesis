	keywords = {/unread, 相对运动, 椭圆轨道, 卫星编队飞行, 编队控制, 摄动, 相对姿态控制},
	file = {陈健_2011_编队飞行卫星控制方法研究.pdf:D\:\\Reference\\Zotero\\ZoteroData\\storage\\NVKMNZXT\\陈健_2011_编队飞行卫星控制方法研究.pdf:application/pdf},
