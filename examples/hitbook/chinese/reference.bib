@phdthesis{__2023-2,
	type = {硕士学位论文},
	title = {航天器抵近观测博弈策略研究},
	url = {https://d.wanfangdata.com.cn/thesis/D03151899},
	abstract = {随着航天技术的不断发展以及太空形势日益复杂，各国航天器之间非合作和博弈对抗的态势逐渐显现。而航天器间的轨道博弈成为了研究的热点。本学位论文以此为背景，研究了运行在地球同步轨道(Geostationary Orbit,GEO)的航天器抵近观测博弈策略，进一步分为近距离和远距离两种情况，针对不同情况的博弈问题给出了不同的最优机动策略的求解方法。主要研究内容包括： 针对完全信息的航天器抵近观测静态博弈场景，提出了基于智能算法协同进化的终端状态优化策略，对于远距离的场景通过迭代法对脉冲机动策略进行修正。首先建立了两航天器抵近观测博弈策略的模型，基于CW(Clohessy Wiltshire)方程计算终端时刻两航天器的相对位置，以终端时刻两航天器的相对距离和终端时刻的光照角为优化指标，运用多目标粒子群优化算法，通过两种群协同进化的方法，按照一定原则对所得到的非劣解进行筛选，从而得到两航天器最优的机动策略。对于近距离抵近观测，双方航天器采用单脉冲机动，而对于远距离的抵近观测则采用多脉冲机动。在远距离抵近观测的问题中，为了克服CW方程的建模误差以及轨道摄动等因素的影响，采用迭代法对多脉冲机动策略进行修正。 针对不完全信息的航天器近距离抵近观测动态博弈场景，提出了基于单脉冲可达域的优化策略。首先求解航天器在单脉冲作用下短时间内的可达域。然后将逃避航天器的可达域进行离散，利用改进的差分进化算法去求取在追踪航天器可达域内对逃避航天器抵近观测的最优位置，并采用在时间和空间上更为灵活的兰伯特机动作为追踪航天器的转移方式。同时，本文提出的改进的差分进化算法相比传统的差分进化算法收敛更快，得到的结果更优。 针对不完全信息的航天器远距离抵近观测动态博弈场景，提出了一种双层寻优的回合制博弈最优机动策略求解方案。根据GEO航天器的特点以及远距离博弈节省燃料的要求，假设双方航天器只通过调相机动进行转移并且在一个调相周期后返回GEO轨道。基于该博弈问题具有回合制的特点，本文提出了双层寻优的求解最优机动策略的方案。先通过量子遗传算法找到不同追踪航天器机动策略下的最优的逃避航天器机动策略，再按照一定准则筛选出最优的追踪航天器机动策略。},
	urldate = {2024-04-27},
	school = {哈尔滨工业大学},
	author = {{于永彬}},
	collaborator = {{郭延宁}},
	year = {2023},
	note = {major: 控制工程
CLC: V412.41(基础理论及试验)},
	keywords = {航天器, 抵近观测, 多目标优化, 轨道博弈},
	file = {于永彬_2023_航天器抵近观测博弈策略研究.pdf:D\:\\Reference\\Zotero\\ZoteroData\\storage\\428X7IKZ\\于永彬_2023_航天器抵近观测博弈策略研究.pdf:application/pdf},
}

@article{__2023-3,
	title = {混合空间目标下的多航天器抵近观测任务规划},
	volume = {44},
	issn = {1000-1328},
	url = {https://d.wanfangdata.com.cn/periodical/yhxb202312010},
	doi = {10.3873/j.issn.1000-1328.2023.12.009},
	abstract = {研究了服务航天器对多个空间目标的抵近观测任务规划问题,并考虑了高价值航天器、普通航天器以及失效航天器或空间碎片3类待观测目标.通过构建合理的评价体系,对目标观测的任务方案进行评分.建立了综合观测目标数量、观测目标类型、燃料消耗、单次点火速度增量以及任务时长的多约束优化模型,涉及的优化变量包括目标分配向量、观测次序向量以及观测时刻向量.服务航天器通过一种四脉冲机动策略抵近每个目标.采用进化算法求解规划问题,并提出一种基于动态规划(DP)的局部搜索策略以优化观测时刻,提升优化效率.最后分别给出了针对单一类型和混合类型空间目标的抵近观测任务规划算例,通过与传统进化算法的求解结果对比,说明了所提出的DP搜索策略的优势.},
	number = {12},
	urldate = {2024-04-27},
	journal = {宇航学报},
	author = {{李传江} and {闫慧达} and {郭延宁} and {耿远卓} and {叶睿卿}},
	year = {2023},
	note = {CLC: V448.2(航天仪表、航天器设备、航天器制导与控制)},
	keywords = {/unread, 抵近观测, 动态规划, 多航天器, 混合空间目标, 任务规划},
	pages = {1871--1882},
	file = {李传江+_2023_宇航学报_混合空间目标下的多航天器抵近观测任务规划.pdf:D\:\\Reference\\Zotero\\ZoteroData\\storage\\L59NGMRJ\\李传江+_2023_宇航学报_混合空间目标下的多航天器抵近观测任务规划.pdf:application/pdf},
