	url = {https://arc.aiaa.org/doi/10.2514/6.1982-1399},
	doi = {10.2514/6.1982-1399},
	abstract = {The general problem of the motion of an artificial satellite with atmospheric drag and the mathematcal formulation of the variational equations for this problem is revisited. Relevant advances for the analytic and semianalytic solutions of the coupled problem with drag are outlined. This paper discusses the complex nature of the dynamieal system and presents some of the existing solutions and their numerical results when available.},
