@phdthesis{_j2_2019,
	type = {硕士学位论文},
	title = {J$_{\textrm{2}}$以外的微小摄动力对卫星编队飞行影响的研究},
	url = {https://kns.cnki.net/KCMS/detail/detail.aspx?dbcode=CMFD&dbname=CMFD201901&filename=1016302470.nh},
	abstract = {近年来,由于卫星编队具有非常大的应用潜力,受到了国内外学者的广泛关注。由于空间环境的复杂摄动力对卫星编队的长期飞行具有不可忽略的负面影响,因而得到了学者们的大量研究。目前,研究最多的是J2摄动对卫星编队的影响。众所周知,J2摄动对轨道倾角没有长期的影响。尽管第三体引力和J2以外的其他非球形引力等微小摄动力比J2小很多,由于其对轨道倾角有长期的或长周期的影响,因此在实际应用中,研究第三体等微小摄动对卫星长期编队飞行的影响是有价值的。本课题的主要研究内容分为以下两个方面。首先,推导了近地轨道卫星在第三体引力摄动下基于参考卫星轨道要素(RSV,Reference Satellite Variable)的卫星运动方程以及卫星编队飞行的相对运动方程。在推导过程中,为了使推导的结果更为合理且其形式能更为简洁,做出了如下的合理假设:一是卫星到地球的距离远小于到月球的距离;二是地球具有理想的球型引力场。基于这些假设所推导的卫星运动方程及其相对运动方程形式简洁、且较为精确。这些方程对深入研究第三体引力摄动的影响具有重要意义。由于两组方程均以显式给出,并且选取的卫星轨道要素的物理意义清晰,本文利用这些特点对第三体引力的影响作了初步的定性分析。其次,研究了微小非球形引力摄动对卫星编队飞行的影响。在微小非球形引力摄动的研究中,首先推导了顺从J2摄动的周期相对轨道,给出了J2摄动下卫星编队飞行的自然周期轨道的初值,精巧设计了研究J2以外其他微小摄动力的实验方案,并利用STK和Matlab进行仿真实验。通过对实验结果的分析,给出了高阶非球形引力摄动对轨道构型影响的具体结论。本课题的贡献在于通过对J2摄动以外的其它微小摄动的研究,为卫星编队飞行的后续研究工作以及在轨道构型设计中顺从第三体引力摄动和微小非球形引力摄动提供了参考,从而为能够更精确地设计卫星编队轨道构型提供理论上和技术上的支持。},
	language = {zh-CN},
	urldate = {2024-04-27},
	school = {沈阳航空航天大学},
	author = {{罗健夫}},
	collaborator = {{徐光延}},
	year = {2019},
	note = {major: 控制工程
