@phdthesis{__2018,
	type = {硕士学位论文},
	title = {伴飞飞行器末制导方法研究},
	url = {https://kns.cnki.net/KCMS/detail/detail.aspx?dbcode=CMFD&dbname=CMFD201801&filename=1017863416.nh},
	abstract = {本文以伴飞飞行器为研究对象,主要针对伴飞飞行器末制导方法进行研究分析。建立了伴飞飞行器末制导控制系统的详细数学模型,提出了三种末制导律:BANG-BANG型变结构末制导律,自适应滑模末制导律(AD\_ASMG)和非奇异终端滑模末制导律(AD\_NTSMG)。由于伴飞飞行器具有初始速度快、制导时间短和不知道拦截飞行器机动能力上界等特点,现有制导方法无法满足伴飞飞行器末制导律需求。目前,也没有针对拦截飞行器机动能力上界未知情况的制导律设计方法的报道。因此,本文先采用零化视线转率的制导策略设计了BANG-BANG型变结构末制导律,来探索伴飞飞行器的过载需求。采用基于视线制导策略,同时考虑了零化视线转率制导策略设计AD\_ASMG和AD\_NTSMG末制导律。AD\_ASMG是通过设计滑模切换项增益自适应律,实现了在不知道拦截飞行器机动能力上界的情况下自适应调整进行制导。AD\_NTSMG是利用有限时间收敛理论和非奇异终端滑模控制理论设计的末制导律。伴飞飞行器轨控发动机产生的推力大小不可调节,因此BANG-BANG型变结构末制导律很容易实现。AD\_ASMG和AD\_NTSMG末制导律制导指令是连续变化的,无法直接实现,本文利用动量等效原理,通过控制发动机工作时间使发动机输出变化的等效力,满足了这两种末制导律的需要。经过仿真验证,从仿真结果可以看到,采用BANG-BANG型变结构末制导律,在机动能力达到5g时,脱靶量为0.24m。采用AD\_ASMG末制导律时,在机动能力为3g时,脱靶量为0.08m;采用AD\_NTSMG末制导律在机动能力为4g时,脱靶量也基本小于0.28m。验证结果说明,设计的AD\_ASMG和AD\_NTSMG两种末制导律可以在伴飞飞行器过载能力较小的情况下满足末制导阶段的任务要求。},
	language = {zh-CN},
	urldate = {2024-04-27},
	school = {哈尔滨工业大学},
	author = {{吴世凯}},
	collaborator = {{周荻}},
	year = {2018},
	note = {major: 控制科学与工程
