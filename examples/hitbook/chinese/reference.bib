	keywords = {/unread, 姿态控制, 相对运动, 椭圆轨道, 卫星编队飞行, 编队控制, 摄动},
	file = {张玉锟_2004_卫星编队飞行的动力学与控制技术研究.pdf:D\:\\Reference\\Zotero\\ZoteroData\\storage\\A7PIHC6F\\张玉锟_2004_卫星编队飞行的动力学与控制技术研究.pdf:application/pdf},
