	file = {孙雪娇_2017_卫星编队飞行队形控制的参数化方法.pdf:D\:\\Reference\\Zotero\\ZoteroData\\storage\\PX4S9S9C\\孙雪娇_2017_卫星编队飞行队形控制的参数化方法.pdf:application/pdf},
