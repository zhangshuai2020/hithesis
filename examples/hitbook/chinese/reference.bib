}

@phdthesis{__2014-2,
	type = {硕士学位论文},
	title = {卫星编队飞行相对轨道控制},
	url = {https://kns.cnki.net/KCMS/detail/detail.aspx?dbcode=CMFD&dbname=CMFD201401&filename=1013305801.nh},
	abstract = {卫星编队飞行是指将单颗复杂大卫星所具有的功能分配给一组具有一定空间构型、相互协作的小卫星。因其具有广泛而诱人的发展前景，已成为航天领域的研究热点。本文研究了主-从结构下圆轨道卫星编队飞行的相对轨道控制问题，即对从星设计控制器以使其相对主星按照期望的相对轨道飞行。主要研究内容如下：1）对不考虑扰动影响的理想卫星编队飞行，提出了有限时间稳定PD+控制方法；对存在有界不确定干扰的卫星编队飞行，提出了快速终端滑模控制方法；对存在参数不确定性和有界不确定干扰的卫星编队飞行，提出了快速终端滑模自适应控制方法；对存在参数不确定性以及速度信息未知的卫星编队飞行，提出了输出反馈自适应控制方法。2）运用相关稳定性理论证明了上述所提出的各种控制方法的稳定性。数值仿真验证了所提控制方法的优越性。},
